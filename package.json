{
  "name": "nb-speak",
  "version": "0.2.0",
  "description": "Stop Personal Agents (OpenClaw, AstrBot, Claude Code, Telegram, WhatsApp, WeChat, QQ) from dumping raw pipe tables and 250-word Markdown essays. Universal send_message + send_artifact IM bubble protocol, PA plugins, SSE bridge, and chat-human Skill.",
  "license": "MIT",
  "author": "Nai Long 7th <nailong@xter.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NB-Corp/nb-speak.git"
  },
  "homepage": "https://nb-corp.github.io/nb-speak/",
  "bugs": {
    "url": "https://github.com/NB-Corp/nb-speak/issues"
  },
  "type": "module",
  "bin": {
    "nb-speak": "./packages/core/bin/nb-speak.mjs",
    "nb-speak-bridge": "./packages/core/bin/nb-speak.mjs",
    "nb-speak-openclaw": "./packages/openclaw-plugin/scripts/install-openclaw.mjs",
    "nb-speak-dsh": "./packages/dsh-plugin/scripts/install-dsh.mjs"
  },
  "exports": {
    ".": {
      "types": "./packages/core/src/index.ts",
      "default": "./packages/core/dist/index.js"
    },
    "./openclaw": {
      "types": "./packages/openclaw-plugin/src/plugin.ts",
      "default": "./packages/openclaw-plugin/dist/plugin.js"
    },
    "./dsh": {
      "types": "./packages/dsh-plugin/src/plugin.ts",
      "default": "./packages/dsh-plugin/dist/plugin.js"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:core": "node --test packages/core/tests/*.test.ts",
    "test:openclaw": "node --test packages/openclaw-plugin/tests/*.test.ts",
    "test:dsh": "node --test packages/dsh-plugin/tests/*.test.ts",
    "test:astrbot": "python -B -m unittest discover -s integrations/astrbot_plugin_nb_speak/tests -v",
    "test:py": "python -B -m unittest discover -s tests -v",
    "test": "npm run build && npm run test:core && npm run test:openclaw && npm run test:dsh && npm run test:astrbot && npm run test:py",
    "serve": "node packages/core/bin/nb-speak.mjs serve",
    "lint": "node packages/core/bin/nb-speak.mjs lint"
  }
}

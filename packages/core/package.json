{
  "name": "@nb-corp/nb-speak",
  "version": "0.2.0",
  "description": "Universal send_message + send_artifact IM bubble protocol, plain-reply fallback parser, deterministic bubble_lint, and zero-dependency OpenAI/SSE bridge for AI agents.",
  "license": "MIT",
  "author": "Nai Long 7th <nailong@xter.org>",
  "homepage": "https://nb-corp.github.io/nb-speak/",
  "bugs": {
    "url": "https://github.com/NB-Corp/nb-speak/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NB-Corp/nb-speak.git",
    "directory": "packages/core"
  },
  "keywords": [
    "ai-agents",
    "chat-ui",
    "im-protocol",
    "send-message",
    "tool-calling",
    "openai-bridge",
    "sse",
    "tts",
    "voice-notes",
    "chat-human",
    "nb-corp"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "nb-speak": "./bin/nb-speak.mjs",
    "nb-speak-bridge": "./bin/nb-speak.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./dist/protocol.js"
    },
    "./lint": {
      "types": "./src/lint.ts",
      "default": "./dist/lint.js"
    },
    "./parser": {
      "types": "./src/parser.ts",
      "default": "./dist/parser.js"
    },
    "./bridge": {
      "types": "./src/bridge.ts",
      "default": "./dist/bridge.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}

{
  "name": "@nb-corp/nb-speak-dsh",
  "version": "0.3.1",
  "description": "Full-stack DeepSeek Harness (DSH) plugin + WebUI client extension for nb-speak (standalone repo: NB-Corp/nb-speak-dsh): native send_bubble & send_artifact tools, tactile IM chat bubbles, playable voice-note pills, interactive artifact cards, continuous 5-axis persona weights, and optional Mode B voice-model bridge.",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "Nai Long 7th <nailong@xter.org>",
  "homepage": "https://nb-corp.github.io/nb-speak-dsh/",
  "bugs": {
    "url": "https://github.com/NB-Corp/nb-speak/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NB-Corp/nb-speak.git",
    "directory": "packages/dsh-plugin"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "nb-speak",
    "chat-human",
    "send-message",
    "im-protocol",
    "nb-corp"
  ],
  "type": "module",
  "main": "./dist/plugin.js",
  "types": "./src/plugin.ts",
  "bin": {
    "nb-speak-dsh": "./scripts/install-dsh.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./dist/plugin.js"
    },
    "./agent": {
      "types": "./src/agent.ts",
      "default": "./dist/agent.js"
    },
    "./dsh-tools": {
      "types": "./src/dsh-tools.ts",
      "default": "./dist/dsh-tools.js"
    },
    "./client": "./dist/client.js",
    "./client-model": {
      "types": "./src/client-model.ts",
      "default": "./dist/client-model.js"
    },
    "./weights": {
      "types": "./src/weights.ts",
      "default": "./dist/weights.js"
    },
    "./tool-remap": {
      "types": "./src/tool-remap.ts",
      "default": "./dist/tool-remap.js"
    },
    "./upstream": {
      "types": "./src/upstream.ts",
      "default": "./dist/upstream.js"
    },
    "./http-bridge": {
      "types": "./src/http-bridge.ts",
      "default": "./dist/http-bridge.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/nb-speak.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "presets",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "install:dry-run": "node scripts/install-dsh.mjs --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-rc.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.0",
    "@deepseek-ai/schemastery": ">=3.18.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}

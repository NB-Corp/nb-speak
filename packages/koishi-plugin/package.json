{
  "name": "koishi-plugin-nb-speak",
  "version": "0.2.0",
  "description": "Stop chatbots from dumping raw Markdown pipe tables and 250-word essays on OneBot/QQ, WeChat, Telegram, Discord, and Feishu.",
  "license": "MIT",
  "author": "Nai Long 7th <nailong@xter.org>",
  "homepage": "https://nb-corp.github.io/nb-speak/",
  "bugs": {
    "url": "https://github.com/NB-Corp/nb-speak/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NB-Corp/nb-speak.git",
    "directory": "packages/koishi-plugin"
  },
  "keywords": [
    "koishi",
    "plugin",
    "chatbot",
    "im",
    "markdown",
    "onebot",
    "telegram"
  ],
  "koishi": {
    "description": {
      "en": "Convert raw Markdown pipe tables and 250-word LLM walls into paced IM bubbles and mobile key-value/code cards (voice notes off by default).",
      "zh": "拦截大模型长篇回复与裸 Markdown 管道表格，按真人打字节奏拆分为短气泡与手机端键值/代码卡片（默认关闭语音条）。"
    },
    "locales": [
      "en",
      "zh"
    ],
    "service": {
      "required": [],
      "optional": []
    }
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "koishi": "^4.18.0"
  }
}

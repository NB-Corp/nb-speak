{
  "name": "@nb-corp/nb-speak-openclaw",
  "version": "0.2.1",
  "description": "Native OpenClaw plugin & deterministic outbound gate: stops raw Markdown pipe-table dumps (#36323) and 250-word essay walls on Telegram, WhatsApp, Discord, and Signal with paced IM bubbles, code/table cards, and the chat-human skill.",
  "license": "MIT",
  "author": "Nai Long 7th <nailong@xter.org>",
  "homepage": "https://nb-corp.github.io/nb-speak/",
  "bugs": {
    "url": "https://github.com/NB-Corp/nb-speak/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NB-Corp/nb-speak.git",
    "directory": "packages/openclaw-plugin"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "clawhub",
    "telegram-bot",
    "whatsapp-agent",
    "nb-speak",
    "chat-human",
    "markdown-tables"
  ],
  "type": "module",
  "main": "./dist/plugin.js",
  "types": "./src/plugin.ts",
  "bin": {
    "nb-speak-openclaw": "./scripts/install-openclaw.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/plugin.ts",
      "default": "./dist/plugin.js"
    },
    "./format-gate": {
      "types": "./src/format-gate.ts",
      "default": "./dist/format-gate.js"
    },
    "./openclaw.plugin.json": "./openclaw.plugin.json",
    "./package.json": "./package.json"
  },
  "openclaw": {
    "extensions": [
      "./dist/plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24",
      "minGatewayVersion": "2026.3.24"
    },
    "build": {
      "openclawVersion": "2026.11.5",
      "pluginSdkVersion": "2026.11.5"
    }
  },
  "files": [
    "assets",
    "dist",
    "src",
    "scripts",
    "skills",
    "openclaw.plugin.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "install:dry-run": "node scripts/install-openclaw.mjs --dry-run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.3.24"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  }
}
